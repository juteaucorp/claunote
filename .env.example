# Copier en .env et remplir
POSTGRES_USER=claunote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claunote
# IP de la VM sur ton VPN (le site n'écoute que là)
BIND_ADDR=127.0.0.1
# kDrive via l'API REST Infomaniak (pas de montage)
# Jeton créé sur https://manager.infomaniak.com/v3/ng/accounts/token/list avec le scope « drive »
KDRIVE_TOKEN=
# ID du kDrive : le nombre après /drive/ dans l'URL de l'appli web
KDRIVE_ID=
# ID des dossiers : le nombre après /files/ quand tu ouvres le dossier dans l'appli web
KDRIVE_ETUDES_ID=
KDRIVE_INBOX_ID=
# Agent IA : jeton de ton forfait Claude Pro, généré par `claude setup-token` (valable 1 an)
# Pas de clé API nécessaire.
CLAUDE_CODE_OAUTH_TOKEN=
# Modèles : chaque tâche a le sien (Haiku pour le texte simple, Sonnet pour les scans et fiches,
# Opus pour les épreuves blanches et les seconds avis quand l'agent doute). Voir la page État du site.
# Pour changer une tâche : CLAUDE_MODELES=examen=sonnet,scan=opus
# (tâches : scan, texte, classement, dossiers, fiche, quiz, cartes, plan, programme, examen)
CLAUDE_MODELES=
# Modèle le plus fort autorisé (opus, sonnet ou haiku) : sonnet pour ne jamais utiliser Opus
CLAUDE_MODELE_MAX=opus
# Appels à Claude en même temps (1 à 6) : 3 analyses ou morceaux d'un long scan à la fois.
# Même quota consommé, juste plus vite. Mets 1 si tu veux garder le forfait libre pour toi.
CLAUDE_PARALLELE=3
# Documents analysés par passage du worker (vide : 4 × CLAUDE_PARALLELE)
WORKER_LOT=
# Pronote (page Agenda) : synchro toutes les N heures
PRONOTE_INTERVALLE_H=3
# 1 = prépare tout seul une fiche ou un plan pour chaque évaluation à moins de 10 jours
# (consomme ton forfait Claude Pro), 0 = seulement quand tu cliques sur « Préparer »
PRONOTE_PREPARATION_AUTO=1
# Connexion au site (par défaut admin / claunote : à changer !)
# Le mot de passe peut être écrit en clair, ou haché avec :
#   docker compose run --rm web python -m claunote.auth
CLAUNOTE_UTILISATEUR=admin
CLAUNOTE_MOT_DE_PASSE=claunote
# Appli iPhone (HTTPS) : l'adresse que tu tapes sur le téléphone pour joindre la VM par le VPN
# (son IP VPN, ou un nom si ton VPN a un DNS). Puis ouvre http://<BIND_ADDR>:8000/installer
CLAUNOTE_HOTE=
HTTPS_PORT=443
# Contact donné à Apple/Google avec chaque notification (ton e-mail, format mailto:)
CLAUNOTE_PUSH_CONTACT=mailto:claunote@example.com
# Un PDF de plus de N pages (scan d'une année entière…) est d'abord découpé en documents séparés
DECOUPAGE_PAGES=40
