# Copier en .env et remplir
POSTGRES_USER=claunote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claunote
# IP de la VM sur ton VPN (le site n'écoute que là)
BIND_ADDR=127.0.0.1
# kDrive, Claude, Cloudflare : peuvent rester vides et se régler sur le site (assistant d'installation, puis
# Réglages → Installation). Un réglage fait sur le site passe avant celui de ce fichier.
# kDrive via l'API REST Infomaniak (pas de montage)
# Jeton créé sur https://manager.infomaniak.com/v3/ng/accounts/token/list avec le scope « drive »
KDRIVE_TOKEN=
# ID du kDrive : le nombre après /drive/ dans l'URL de l'appli web
KDRIVE_ID=
# ID des dossiers : le nombre après /files/ quand tu ouvres le dossier dans l'appli web
KDRIVE_ETUDES_ID=
KDRIVE_INBOX_ID=
# Agent IA : jeton de ton forfait Claude Pro, généré par `claude setup-token` (valable 1 an)
# Pas de clé API : une ANTHROPIC_API_KEY présente serait ignorée (jamais de facturation à l'usage).
CLAUDE_CODE_OAUTH_TOKEN=
# Modèles : chaque tâche a le sien (Haiku pour le texte simple, Sonnet pour les scans et fiches,
# Opus pour les épreuves blanches et les seconds avis quand l'agent doute). Voir la page État du site.
# Pour changer une tâche : CLAUDE_MODELES=examen=sonnet,scan=opus
# (tâches : scan, texte, classement, dossiers, fiche, quiz, cartes, plan, programme, examen, question, matieres, controle)
CLAUDE_MODELES=
# Modèle le plus fort autorisé (opus, sonnet ou haiku) : sonnet pour ne jamais utiliser Opus
CLAUDE_MODELE_MAX=opus
# Appels à Claude en même temps (1 à 6) : 3 analyses ou morceaux d'un long scan à la fois.
# Même quota consommé, juste plus vite. Mets 1 si tu veux garder le forfait libre pour toi.
CLAUDE_PARALLELE=3
# Documents analysés par passage du worker (vide : 4 × CLAUDE_PARALLELE)
WORKER_LOT=
# Pronote (page Agenda) : synchro toutes les N heures
PRONOTE_INTERVALLE_H=3
# 1 = prépare tout seul une fiche ou un plan pour chaque évaluation à moins de 10 jours
# (consomme ton forfait Claude Pro), 0 = seulement quand tu cliques sur « Préparer »
PRONOTE_PREPARATION_AUTO=1
# Connexion au site : premier compte, l'admin (par défaut admin / claunote : à changer !)
# Lu une seule fois, au premier démarrage avec les comptes : ensuite, tout se gère sur le site
# (Réglages → Compte pour ton mot de passe, Réglages → Comptes pour inviter quelqu'un avec un jeton de 15 min).
# Mot de passe de l'admin perdu : docker compose exec web python -m claunote.auth reinitialiser (reprend celui-ci)
# Le mot de passe peut être écrit en clair, ou haché avec :
#   docker compose run --rm web python -m claunote.auth
CLAUNOTE_UTILISATEUR=admin
CLAUNOTE_MOT_DE_PASSE=claunote
# Appli iPhone (HTTPS) : l'adresse que tu tapes sur le téléphone pour joindre la VM par le VPN
# (son IP VPN, ou un nom si ton VPN a un DNS). Puis ouvre http://<BIND_ADDR>:8000/installer
CLAUNOTE_HOTE=
HTTPS_PORT=443
# Contact donné à Apple/Google avec chaque notification (ton e-mail, format mailto:)
CLAUNOTE_PUSH_CONTACT=mailto:claunote@example.com
# Qui fait le travail (analyses, reclassements, noms de dossiers, matières, chat) ; modifiable sur la page Activité :
#   local    = le modèle local d'abord, Claude seulement s'il doute ou demande de l'aide (et 1 contrôle sur 10)
#   auto     = Claude d'abord, le modèle local seulement quand Claude n'est pas disponible
#   toujours = modèle local uniquement ; jamais = Claude uniquement
ANALYSE_LOCALE=local
# Modèles Ollama : qwen2.5:1.5b pour une petite VM (4 Go), qwen2.5:7b avec 16 Go de RAM ; nomic-embed-text : recherche par le sens
OLLAMA_MODELE=qwen2.5:3b
OLLAMA_EMBED=nomic-embed-text
# Analyses locales en même temps (1 à 4) : chaque OCR occupe un cœur
LOCAL_PARALLELE=1
# La VM ne sature pas : au-delà, le surplus part chez Claude (charge par cœur, Mo libres, minutes d'attente de la file)
LOCAL_CHARGE_MAX=0.85
LOCAL_MEMOIRE_MIN_MO=600
LOCAL_ATTENTE_MAX_MIN=30
# Part des analyses locales sûres d'elles que Claude contrôle quand même (mesure de fiabilité, page Activité)
LOCAL_CONTROLE=0.1
# Un PDF de plus de N pages (scan d'une année entière…) est d'abord découpé en documents séparés
DECOUPAGE_PAGES=40
# Mise à jour depuis le site (Réglages → Mise à jour), si le dépôt GitHub est privé : jeton « fine-grained »
# limité au dépôt claunote, permission Contents en lecture seule (github.com/settings/personal-access-tokens).
# Resource owner : le propriétaire du dépôt (l'organisation juteaucorp pour le dépôt d'origine).
GITHUB_TOKEN=
# Service lecture (PDF avec tableaux, photo de formule → LaTeX, tri des passages du chat) : cœurs par calcul
LECTURE_THREADS=2
# Flashcards (FSRS) : part des cartes qu'on veut encore savoir le jour où elles reviennent (0.8 à 0.95)
FSRS_RETENTION=0.9
# Processeur sur la durée : au-delà de cette occupation moyenne (sur CPU_FENETRE_MIN minutes), le travail
# de fond fait des pauses (les pics à 100 % restent permis). OLLAMA_THREADS : cœurs d'Ollama (vide = tous sauf un)
CPU_MOYENNE_MAX=0.6
CPU_FENETRE_MIN=15
OLLAMA_THREADS=
# Mémoire : temps de garde du modèle Ollama après sa dernière réponse, et des modèles du service lecture
OLLAMA_GARDER=5m
LECTURE_GARDER_MIN=10
# Accès par Internet par Cloudflare Tunnel (infra/SETUP.md, section 17) : décommente les 2 lignes
# et colle le jeton du tunnel (Zero Trust → Réseaux → Tunnels → ton tunnel → jeton).
#COMPOSE_PROFILES=tunnel
#CLOUDFLARE_TUNNEL_TOKEN=
# Par Internet, seuls les appareils approuvés (Réglages → Compte) ouvrent le site ; 0 = pas de contrôle
CLAUNOTE_TUNNEL_APPAREILS=1
# Pays acceptés par Internet (codes Cloudflare, séparés par des virgules) ; le site refuse les autres même si la
# règle Cloudflare saute. À l'étranger : CLAUNOTE_PAYS=FR,ES par exemple, ou * pour tout accepter.
CLAUNOTE_PAYS=FR
# Seulement si cloudflared ne tourne pas dans ce docker-compose : son nom ou son adresse vue depuis le site
#CLAUNOTE_CLOUDFLARED=
# Contact affiché dans les mentions légales et la page « Tes données » (ton e-mail, par exemple) ; vide : « l'admin »
CLAUNOTE_CONTACT=
# Disque : alerte aux admins sous ces seuils (Go libres) ; une alerte aussi sous 10 % libres
DISQUE_ATTENTION_GO=5
DISQUE_CRITIQUE_GO=2
