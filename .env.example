# Copier en .env et remplir
POSTGRES_USER=claunote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claunote
# IP de la VM sur ton VPN (le site n'écoute que là)
BIND_ADDR=127.0.0.1
# kDrive via l'API REST Infomaniak (pas de montage)
# Jeton créé sur https://manager.infomaniak.com/v3/ng/accounts/token/list avec le scope « drive »
KDRIVE_TOKEN=
# ID du kDrive : le nombre après /drive/ dans l'URL de l'appli web
KDRIVE_ID=
# ID des dossiers : le nombre après /files/ quand tu ouvres le dossier dans l'appli web
KDRIVE_ETUDES_ID=
KDRIVE_INBOX_ID=
# Agent IA : jeton de ton forfait Claude Pro, généré par `claude setup-token` (valable 1 an)
# Pas de clé API nécessaire.
CLAUDE_CODE_OAUTH_TOKEN=
# Modèle utilisé pour l'analyse des scans (sonnet conseillé avec un forfait Pro)
CLAUDE_MODEL=sonnet
# Nombre de scans analysés par passage du worker
WORKER_LOT=5
# Pronote (page Agenda) : synchro toutes les N heures
PRONOTE_INTERVALLE_H=3
# 1 = prépare tout seul une fiche ou un plan pour chaque évaluation à moins de 10 jours
# (consomme ton forfait Claude Pro), 0 = seulement quand tu cliques sur « Préparer »
PRONOTE_PREPARATION_AUTO=0
# Connexion au site (par défaut admin / claunote : à changer !)
# Le mot de passe peut être écrit en clair, ou haché avec :
#   docker compose run --rm web python -m claunote.auth
CLAUNOTE_UTILISATEUR=admin
CLAUNOTE_MOT_DE_PASSE=claunote
