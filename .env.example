# Copier en .env et remplir
POSTGRES_USER=claunote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claunote
# IP de la VM sur ton VPN (le site n'écoute que là)
BIND_ADDR=127.0.0.1
# Dossier kDrive monté par rclone sur la VM
KDRIVE_ETUDES=/mnt/kdrive/Etudes
# Agent IA : jeton de ton forfait Claude Pro, généré par `claude setup-token` (valable 1 an)
# Pas de clé API nécessaire.
CLAUDE_CODE_OAUTH_TOKEN=
